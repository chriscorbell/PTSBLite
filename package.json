{
  "name": "ptsbuilder",
  "version": "0.1.3",
  "description": "Cross-platform desktop 3D builder for pneumatic tube systems",
  "author": "Chris Corbell <hi@chriscorbell.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/chriscorbell/PTSBuilder"
  },
  "main": "out/main/main.cjs",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "pnpm run build && electron-builder",
    "package:dir": "pnpm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "lucide-react": "^1.26.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
